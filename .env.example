# Copy to .env at the repo root and fill in. Never commit .env.

# OpenAI-compatible model endpoint (prompted API model or the fine-tune)
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model-name
MODEL_API_KEY=your-model-api-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# Set to true to run on the in-memory store and the rule-based fake model, with no credentials
USE_FAKES=false

# Origins allowed to call the API from a browser, comma separated
CORS_ORIGINS=http://localhost:3000
