      "form": {
        "annual_income": 120000, "loan_amount": 240000, "annuity": 1800, "goods_price": 220000,
        "ext_source_1": 0.7, "ext_source_2": 0.7, "ext_source_3": 0.7
      },
      "documents": [
        {"name": "salary_slip.txt", "kind": "salary_slip", "text": "Employer: Acme Ltd. Annual income: 80,000"}
      ]
    },
    "expected_status": "needs_info",
    "expected_events": ["fields_extracted", "recommendation", "routed"],
    "reply": {
      "answer": "The salary slip is correct; my form figure was a typo.",
