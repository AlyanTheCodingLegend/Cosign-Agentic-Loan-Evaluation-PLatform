[
  {
    "key": "clean_approve",
    "description": "Healthy ratios, all three external scores present, documents agree with the form.",
    "input": {
      "form": {
        "annual_income": 120000, "loan_amount": 240000, "annuity": 2500, "goods_price": 220000,
        "years_employed": 6.0, "ext_source_1": 0.72, "ext_source_2": 0.68, "ext_source_3": 0.70
      },
      "documents": [
        {"name": "salary_slip.txt", "kind": "salary_slip", "text": "Employer: Acme Ltd. Annual income: 120,000"}
      ]
    },
    "expected_status": "auto_cleared",
    "expected_events": ["fields_extracted", "recommendation", "routed"]
  },
  {
    "key": "missing_scores_low_confidence",
    "description": "Two of three external scores are null, so the agent is less confident and a human reviews.",
    "input": {
      "form": {
        "annual_income": 120000, "loan_amount": 240000, "annuity": 2500, "goods_price": 220000,
        "years_employed": 3.0, "ext_source_2": 0.66
      }
    },
    "expected_status": "pending_review",
    "expected_events": ["fields_extracted", "recommendation", "routed"]
  },
  {
    "key": "missing_annuity",
    "description": "The form omits the annuity, so the agent asks instead of guessing.",
    "input": {
      "form": {
        "annual_income": 120000, "loan_amount": 240000, "goods_price": 220000,
        "ext_source_1": 0.7, "ext_source_2": 0.7, "ext_source_3": 0.7
      }
    },
    "expected_status": "needs_info",
    "expected_events": ["fields_extracted", "missing_fields"],
    "reply": {
      "answer": "The monthly payment is 2,500.",
      "corrections": {"annuity": 2500},
      "expected_status": "auto_cleared"
    }
  },
  {
    "key": "income_mismatch",
